# 两项变量都留空时使用只读示例模式；发布和评分不会保存。
# 共享功能代码已准备；组长以后创建项目后，复制为 .env.local 并填写。
# 修改后重启开发预览，或重新执行生产构建。
# 前端只填写 publishable key；不要填写 service_role 或服务器私密密钥。

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Enable only after database migration, email delivery and binding are verified.
VITE_FOOD_EMAIL_AUTH_READY=false

# Enable only after the food-profiles migration and owner checks pass.
VITE_FOOD_PROFILES_READY=false
